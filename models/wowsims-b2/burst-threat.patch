+++ b/sim/core/zz_burst.go
@@ -0,0 +1,113 @@
+package core
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"time"
+)
+
+// Burst threat recorder: threat of the player (unit 0 of party 0) on target 0, in 0.1 sec buckets, each iteration.
+const burstStep = 100 * time.Millisecond
+
+var (
+	burstOn   bool
+	burstSim  *Simulation
+	burstRuns [][]float64
+)
+
+func BurstStart() { burstOn = true; burstRuns = nil }
+
+func burstIter(sim *Simulation) {
+	if !burstOn {
+		return
+	}
+	burstSim = sim
+	n := int(sim.Duration/burstStep) + 2
+	burstRuns = append(burstRuns, make([]float64, n))
+}
+
+func burstRecord(u *Unit, tgt int32, threat float64) {
+	if !burstOn || burstSim == nil || len(burstRuns) == 0 || tgt != 0 || u.Type != PlayerUnit || threat == 0 {
+		return
+	}
+	cur := burstRuns[len(burstRuns)-1]
+	i := int(max(burstSim.CurrentTime, 0) / burstStep)
+	if i >= len(cur) {
+		i = len(cur) - 1
+	}
+	cur[i] += threat
+}
+
+func pct(v []float64, q float64) float64 {
+	s := append([]float64(nil), v...)
+	sort.Float64s(s)
+	return s[int(math.Min(float64(len(s)-1), q*float64(len(s))))]
+}
+
+// BurstReport prints, for the last iters iterations: cumulative threat at each mark (mean, 10th and 90th
+// percentile), and the threat of the best window of each size in the fight (mean of the per-iteration maximum),
+// with the mean window in the second half of the fight.
+func BurstReport(label string, iters int, marks []float64, windows []float64) {
+	runs := burstRuns
+	if len(runs) > iters {
+		runs = runs[len(runs)-iters:]
+	}
+	for k := 1; k <= 100; k++ {
+		mean := 0.0
+		for _, b := range runs {
+			for i := 0; i < k && i < len(b); i++ {
+				mean += b[i]
+			}
+		}
+		if k%5 == 0 {
+			fmt.Printf("CURVE %s %.1f %.1f\n", label, float64(k)*burstStep.Seconds(), mean/float64(len(runs)))
+		}
+	}
+	for _, m := range marks {
+		k := int(math.Round(m / burstStep.Seconds()))
+		vals := make([]float64, len(runs))
+		for r, b := range runs {
+			for i := 0; i < k && i < len(b); i++ {
+				vals[r] += b[i]
+			}
+		}
+		mean := 0.0
+		for _, v := range vals {
+			mean += v
+		}
+		mean /= float64(len(vals))
+		fmt.Printf("BURST %s open %.1f mean %.1f p10 %.1f p90 %.1f\n", label, m, mean, pct(vals, 0.1), pct(vals, 0.9))
+	}
+	for _, w := range windows {
+		k := int(math.Round(w / burstStep.Seconds()))
+		peaks := make([]float64, len(runs))
+		avg := 0.0
+		for r, b := range runs {
+			n := len(b) - 2
+			sum := 0.0
+			best := 0.0
+			for i := 0; i < n; i++ {
+				sum += b[i]
+				if i >= k {
+					sum -= b[i-k]
+				}
+				if i >= k-1 && sum > best {
+					best = sum
+				}
+			}
+			peaks[r] = best
+			// mean window in the second half
+			tot := 0.0
+			for i := n / 2; i < n; i++ {
+				tot += b[i]
+			}
+			avg += tot / float64(n-n/2) * float64(k)
+		}
+		mp := 0.0
+		for _, v := range peaks {
+			mp += v
+		}
+		fmt.Printf("BURST %s window %.0f peak %.1f p10peak %.1f steady %.1f\n", label, w, mp/float64(len(runs)), pct(peaks, 0.1), avg/float64(len(runs)))
+	}
+}
