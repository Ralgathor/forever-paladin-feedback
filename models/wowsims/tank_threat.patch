diff --git a/sim/druid/zz_druid_threat.go b/sim/druid/zz_druid_threat.go
new file mode 100644
index 0000000000..809e112855
--- /dev/null
+++ b/sim/druid/zz_druid_threat.go
@@ -0,0 +1,14 @@
+package druid
+
+import (
+	"os"
+	"strconv"
+)
+
+// Local test values for the Druid ability threat (player data). Off when the variable is not set.
+func druThreat(name string, def float64) float64 {
+	if v, err := strconv.ParseFloat(os.Getenv(name), 64); err == nil {
+		return v
+	}
+	return def
+}
