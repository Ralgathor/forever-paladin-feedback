+package warrior
+
+import (
+	"os"
+	"strconv"
+)
+
+// Local test value for the Warrior ability threat. Off when the variable is not set.
+func warThreat(name string, def float64) float64 {
+	if v, err := strconv.ParseFloat(os.Getenv(name), 64); err == nil {
+		return v
+	}
+	return def
+}
