index 0000000000..65b04b729a
--- /dev/null
+++ b/sim/paladin/zz_new_talents.go
@@ -0,0 +1,52 @@
+package paladin
+
+import (
+	"time"
+
+	"github.com/wowsims/forever/sim/core"
+)
+
+// New Retribution talents of the proposals (row 5). They are not in the beta talent string: flags give the ranks.
+// BZ<n>: Burning Zeal (C-R4), +10% critical damage bonus for each rank on Seals, Judgements and Holy Strike.
+// BZR5: Burning Zeal has 5 ranks, +4% for each rank.
+// MFM<n>: Measure for Measure (C-R5), a dodge or parry of the target reduces the remaining Judgement cooldown by n sec.
+func (paladin *Paladin) applyNewRetributionTalents() {
+	if bz := zzNum("BZ", 0); bz > 0 {
+		mask := SpellMaskHolyStrike | SpellMaskJudgementOfRighteousness | SpellMaskJudgementOfCommand |
+			SpellMaskJudgementOfFury | SpellMaskJudgementOfJustice | SpellMaskJudgementOfTheCrusader |
+			SpellMaskJudgementOfLight | SpellMaskJudgementOfWisdom | SpellMaskSealOfRighteousnessProc |
+			SpellMaskSealOfCommandProc | SpellMaskSealOfFuryProc
+		per := 0.10
+		if prop("BZR5") {
+			per = 0.04
+		}
+		paladin.OnSpellRegistered(func(spell *core.Spell) {
+			if spell.Matches(mask) {
+				spell.CritMultiplierAdditive += per * bz
+			}
+		})
+	}
+	if mfm := zzNum("MFM", 0); mfm > 0 {
+		cut := time.Duration(mfm * float64(time.Second))
+		paladin.MakeProcTriggerAura(core.ProcTrigger{
+			Name:               "Measure for Measure" + paladin.Label,
+			Callback:           core.CallbackOnSpellHitDealt,
+			ProcMask:           core.ProcMaskMelee,
+			Outcome:            core.OutcomeDodge | core.OutcomeParry,
+			TriggerImmediately: true,
+			Handler: func(sim *core.Simulation, _ *core.Spell, _ *core.SpellResult) {
+				jud := paladin.Judgement
+				if jud == nil || jud.CD.Timer == nil || jud.CD.IsReady(sim) {
+					return
+				}
+				jud.CD.Set(max(sim.CurrentTime, jud.CD.ReadyAt()-cut))
+				pa := sim.GetConsumedPendingActionFromPool()
+				pa.NextActionAt = jud.CD.ReadyAt() + core.SpellBatchWindow
+				pa.OnAction = func(sim *core.Simulation) {
+					paladin.ReactToEvent(sim, false, false)
+				}
+				sim.AddPendingAction(pa)
+			},
+		})
+	}
+}
