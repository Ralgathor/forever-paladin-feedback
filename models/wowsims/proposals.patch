@@ -0,0 +1,71 @@
+package paladin
+
+import (
+	"time"
+
+	"github.com/wowsims/forever/sim/core"
+)
+
+// Test values for the Holy proposals (PROPOSE flags):
+// HL30: Healing Light 10/20/30% (C-H4). IOL: Infusion of Light without the critical hit and with Holy
+// Strike (C-H3). LL<n>: Lingering Light at n% (C-H2), the rank is not in the beta tree string.
+// HLR<n>: Healing Light ranks to use with HL30 when the beta string has fewer points.
+
+func (paladin *Paladin) zzApplyHolyProposals() {
+	if pct := zzNum("LL", 0); pct > 0 {
+		paladin.zzLingeringLight(pct / 100)
+	}
+}
+
+type zzLLState struct {
+	pool  float64
+	ticks int
+	pa    *core.PendingAction
+}
+
+func (paladin *Paladin) zzLingeringLight(frac float64) {
+	hot := paladin.RegisterSpell(core.SpellConfig{
+		ActionID:         core.ActionID{SpellID: 1999001},
+		SpellSchool:      core.SpellSchoolHoly,
+		DefenseType:      core.DefenseTypeMagic,
+		ProcMask:         core.ProcMaskSpellHealing,
+		Flags:            core.SpellFlagHelpful | core.SpellFlagPassiveSpell | core.SpellFlagIgnoreAttackerModifiers | core.SpellFlagNoOnCastComplete,
+		DamageMultiplier: 1,
+		ThreatMultiplier: 0.5,
+	})
+	states := map[*core.Unit]*zzLLState{}
+	paladin.RegisterResetEffect(func(_ *core.Simulation) { states = map[*core.Unit]*zzLLState{} })
+	paladin.MakeProcTriggerAura(core.ProcTrigger{
+		Name:           "Lingering Light" + paladin.Label,
+		Callback:       core.CallbackOnHealDealt,
+		ClassSpellMask: SpellMaskHolyLight | SpellMaskFlashOfLight | SpellMaskHolyShockHeal,
+		Outcome:        core.OutcomeCrit,
+		Handler: func(sim *core.Simulation, _ *core.Spell, result *core.SpellResult) {
+			target := result.Target
+			st := states[target]
+			if st == nil {
+				st = &zzLLState{}
+				states[target] = st
+			}
+			if st.pa != nil {
+				st.pa.Cancel(sim)
+			}
+			st.pool += frac * result.Damage
+			st.ticks = 3
+			st.pa = core.StartPeriodicAction(sim, core.PeriodicActionOptions{
+				Period:   2 * time.Second,
+				NumTicks: 3,
+				OnAction: func(sim *core.Simulation) {
+					amount := st.pool / float64(st.ticks)
+					st.pool -= amount
+					st.ticks--
+					r := hot.CalcHealing(sim, target, amount, hot.OutcomeHealingCrit)
+					hot.DealPeriodicHealing(sim, r)
+					if st.ticks == 0 {
+						st.pa = nil
+					}
+				},
+			})
+		},
+	})
+}
diff --git a/sim/paladin/zz_new_talents.go b/sim/paladin/zz_new_talents.go
