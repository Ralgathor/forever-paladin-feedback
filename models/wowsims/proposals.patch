+package paladin
+
+import (
+	"os"
+	"strings"
+	"time"
+	"strconv"
+)
+
+func prop(id string) bool {
+	for _, f := range strings.Split(os.Getenv("PROPOSE"), ",") {
+		if f == id {
+			return true
+		}
+	}
+	return false
+}
+
+func zzEcho() time.Duration {
+	for _, f := range strings.Split(os.Getenv("PROPOSE"), ",") {
+		if strings.HasPrefix(f, "ECHO") {
+			n, _ := strconv.Atoi(f[4:])
+			return time.Duration(n) * time.Second
+		}
+	}
+	return 10 * time.Second
+}
+
+func zzNum(prefix string, def float64) float64 {
+	for _, f := range strings.Split(os.Getenv("PROPOSE"), ",") {
+		if strings.HasPrefix(f, prefix) {
+			if n, err := strconv.ParseFloat(f[len(prefix):], 64); err == nil {
+				return n
+			}
+		}
+	}
+	return def
+}
