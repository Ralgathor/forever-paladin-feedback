diff --git a/sim/core/zz_dump.go b/sim/core/zz_dump.go
new file mode 100644
index 0000000000..7e8f8ee4b5
--- /dev/null
+++ b/sim/core/zz_dump.go
@@ -0,0 +1,40 @@
+package core
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/wowsims/forever/sim/core/proto"
+	"google.golang.org/protobuf/encoding/protojson"
+)
+
+func zzDumpConfigs(dir string, configs []CharacterSuiteConfig) {
+	os.MkdirAll(dir, 0o755)
+	for _, config := range configs {
+		gears := append([]GearSetCombo{config.GearSet}, config.OtherGearSets...)
+		tals := append([]TalentsCombo{{Label: "default", Talents: config.Talents}}, config.OtherTalentSets...)
+		rots := append([]RotationCombo{config.Rotation}, config.OtherRotations...)
+		specs := append([]SpecOptionsCombo{config.SpecOptions}, config.OtherSpecOptions...)
+		for _, g := range gears {
+			for _, t := range tals {
+				for _, r := range rots {
+					for si, so := range specs {
+						if si > 0 && len(specs) > 3 {
+							continue
+						}
+						c := config
+						c.GearSet, c.Talents, c.Rotation, c.SpecOptions = g, t.Talents, r, so
+						p, raid := c.defaultPlayerAndRaid()
+						name := fmt.Sprintf("%s__%s__%s__%s__%s", proto.Class_name[int32(config.Class)], g.Label, t.Label, r.Label, so.Label)
+						name = strings.ReplaceAll(name, "/", "_")
+						b, _ := protojson.Marshal(p)
+						os.WriteFile(dir+"/"+name+".player.json", b, 0o644)
+						rb, _ := protojson.Marshal(raid)
+						os.WriteFile(dir+"/"+name+".raid.json", rb, 0o644)
+					}
+				}
+			}
+		}
+	}
+}
